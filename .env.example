# 1. Create your own Slack app at https://api.slack.com/apps and copy your Client ID.
# 2. Paste it below, then run:
# /usr/bin/python3 -m zoom_slack_status oauth login --env-file .env
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_REDIRECT_URI=http://localhost:8765/slack/oauth/callback

# oauth login writes your personal token here. Do not share this file.
# SLACK_USER_TOKEN=xoxp-user-token-created-by-oauth-login

# Optional customization.
ZOOM_SLACK_STATUS_TEXT=On a Zoom call
ZOOM_SLACK_STATUS_EMOJI=:zoom:
ZOOM_SLACK_STATUS_TTL_MINUTES=120
ZOOM_SLACK_REFRESH_MINUTES=30
# How often the watcher checks Zoom and updates Slack. Lower is more responsive.
ZOOM_SLACK_POLL_SECONDS=5
ZOOM_SLACK_BUSY_CONFIRMATIONS=1
ZOOM_SLACK_IDLE_CONFIRMATIONS=1

# Outlook Calendar for Slack takes precedence over Zoom status when enabled.
ZOOM_SLACK_OUTLOOK_PRECEDENCE=true
ZOOM_SLACK_OUTLOOK_STATUS_TEXTS=In a meeting,Working remotely,Out of office,Lunch

# Reads Outlook for Mac via AppleScript. When a calendar event whose title
# matches one of these labels (e.g. "Lunch") is happening right now, sets
# your Slack status to the text and emoji below until the event ends.
# Requires Outlook for Mac to be installed and running.
ZOOM_SLACK_LUNCH_ENABLED=true
ZOOM_SLACK_LUNCH_LABELS=Lunch
ZOOM_SLACK_LUNCH_STATUS_TEXT=Lunch
ZOOM_SLACK_LUNCH_STATUS_EMOJI=:fork_and_knife:
ZOOM_SLACK_LUNCH_TTL_MINUTES=60
ZOOM_SLACK_OUTLOOK_APP_NAME=Microsoft Outlook

